# ==============================================================================
# FairInvest Backend API cPanel / LiteSpeed Configuration
# Ensures CORS and Authorization headers are handled properly by LiteSpeed/Apache
# ==============================================================================

# 1. Global CORS Headers (Guarantees CORS headers even if LiteSpeed intercepts)
<IfModule mod_headers.c>
  SetEnvIf Origin "^https?://(www\.)?fairinvest\.site$" CORS_ORIGIN=$0
  Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
  Header always set Access-Control-Allow-Origin "https://fairinvest.site" env=!CORS_ORIGIN
  Header always set Access-Control-Allow-Credentials "true"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD"
  Header always set Access-Control-Allow-Headers "Authorization, X-Access-Token, X-HTTP-Authorization, Content-Type, Accept, Origin, X-Requested-With"
</IfModule>

# 2. Authorization and Preflight Handling
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization headers to Node.js backend
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_ACCESS_TOKEN:%{HTTP:X-Access-Token}]

  # Return 200 for OPTIONS preflight requests
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule .* index.html [L]

  # Route non-static API requests to local Node.js process (port 5000)
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ http://127.0.0.1:5000/$1 [P,L]
  </IfModule>
</IfModule>

# 3. Passenger Directives for LiteSpeed / CloudLinux
<IfModule mod_passenger.c>
  PassengerEnabled on
  PassengerAppType node
  PassengerStartupFile app.js
</IfModule>

# Disable directory browsing
Options -Indexes



