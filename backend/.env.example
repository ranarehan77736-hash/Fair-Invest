# FairInvest Backend Production Environment (.env)
# Rename or copy this file to .env in your backend directory on cPanel

NODE_ENV=production
PORT=5000

# ----------------------------------------------------
# DATABASE CONFIGURATION (cPanel MySQL / MariaDB)
# ----------------------------------------------------
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=devsynxc_fairinvest
DB_USER=devsynxc_fairinvest
DB_PASSWORD=zxcvbnm512$$
MYSQL_TIMEZONE=+05:00

# ----------------------------------------------------
# DOMAIN & CORS CONFIGURATION
# ----------------------------------------------------
CLIENT_URL=https://fairinvest.site,https://www.fairinvest.site
ADMIN_URL=https://fairinvest.site/admin

# ----------------------------------------------------
# JWT AUTHENTICATION SECRETS (Generate random strings)
# ----------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_key_access_32chars
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_key_refresh_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------------
# SMTP EMAIL CONFIGURATION (cPanel Email Accounts)
# ----------------------------------------------------
SMTP_HOST=mail.fairinvest.site
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@fairinvest.site
SMTP_PASS=YourEmailAccountPassword123!
SMTP_FROM_NAME=FairInvest
SMTP_FROM_EMAIL=info@fairinvest.site

# ----------------------------------------------------
# AUTH & OTP SETTINGS
# ----------------------------------------------------
# Set REQUIRE_SIGNUP_OTP=true if you want email verification on signup
REQUIRE_SIGNUP_OTP=false
ENABLE_FORGOT_PASSWORD_OTP=true

# ----------------------------------------------------
# PROFIT CALCULATION & SCHEDULER SETTINGS
# ----------------------------------------------------
AUTO_PROFIT_ENABLED=true
AUTO_PROFIT_INTERVAL_MINUTES=5
PROFIT_DAY_MODE=calendar
PROFIT_UTC_OFFSET_HOURS=5
ENABLE_PRINCIPAL_REFUND=false
